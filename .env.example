# Copy to .env and replace these values before starting Docker Compose.
# Generate a strong signing secret with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-before-running
ADMIN_EMAIL=manager@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-10-characters
ADMIN_NAME=Hotel Administrator
CLIENT_ORIGINS=http://localhost,http://127.0.0.1
